# Copy to .env and fill in. .env is gitignored.

DATABASE_URL=postgres://qa:qa@localhost:5433/qa_pov

# Test logins, one pair per role. App configs in qa-apps/ reference these
# variable names; Claude never sees the values.
SYNERGY_QMP_ADMIN_EMAIL=
SYNERGY_QMP_ADMIN_PASSWORD=
SYNERGY_QMP_STUDENT_EMAIL=
SYNERGY_QMP_STUDENT_PASSWORD=

# Vercel "Protection Bypass for Automation" secret, for apps whose preview
# deployments sit behind Vercel's login (bypassSecretEnv in the app config).
SYNERGY_QMP_BYPASS_SECRET=
